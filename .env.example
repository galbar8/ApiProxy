# Every variable here is declared in packages/config/src/config.ts (configSchema).
# Values shown are the defaults unless marked required. Anything missing that a role
# requires is a fatal startup error, never a silent fallback.

# ---- Runtime identity -------------------------------------------------------
APP_ENV=local                       # local | dev | staging | production
SERVICE_NAME=workflow-service
SERVICE_VERSION=0.0.0-dev
AWS_REGION=us-east-1
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace

# ---- HTTP server ------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080

# ---- Timeout ladder (docs/adr/0007-timeout-ladder-and-polling.md) -----------
# SYNC_WAIT_TIMEOUT_MS is the alignment knob: how long POST /v1/process holds the
# connection waiting for a terminal state. Set it comfortably BELOW the timeout of
# the API calling this service, so we return a controlled 202 before the caller
# gives up. The ladder must be strictly increasing or startup fails.
SYNC_WAIT_TIMEOUT_MS=20000
HTTP_REQUEST_TIMEOUT_MS=22000
ALB_IDLE_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=35000    # must exceed ALB_IDLE_TIMEOUT_MS (502 prevention)
HTTP_HEADERS_TIMEOUT_MS=40000
CLIENT_RECOMMENDED_TIMEOUT_MS=35000
SHUTDOWN_DRAIN_MS=25000
# Local default. Behind an ALB this must exceed the health-check detection window
# (interval x (unhealthyThreshold + 1) + timeout), or requests arriving during a drain hit
# a closed listener; the CDK config sets 20000 for that reason (see D-024).
SHUTDOWN_READINESS_DELAY_MS=5000

# ---- Polling ----------------------------------------------------------------
POLL_INITIAL_DELAY_MS=50
POLL_MAX_DELAY_MS=1000
POLL_BACKOFF_FACTOR=1.6
POLL_JITTER_RATIO=0.2

# ---- Business ---------------------------------------------------------------
BUSINESS_DEADLINE_MS=300000
MAX_REQUEST_PAYLOAD_BYTES=122880
MAX_RESULT_BYTES=122880
WORKFLOW_TTL_DAYS=90
OUTBOX_TTL_DAYS=7

# ---- Persistence ------------------------------------------------------------
WORKFLOW_TABLE_NAME=workflow-local              # required (all roles)
DYNAMODB_ENDPOINT=http://localhost:8000         # APP_ENV=local only

# ---- Messaging --------------------------------------------------------------
START_QUEUE_URL=http://localhost:9324/000000000000/workflow-start   # publisher/reconciler
STEP_QUEUE_URL=http://localhost:9324/000000000000/workflow-step     # publisher/reconciler
SQS_ENDPOINT=http://localhost:9324              # APP_ENV=local only

# ---- Authentication (docs/adr/0002-b2b-authentication-api-keys.md) ----------
# API_KEYS_SECRET_ID is required for the api role outside local.
# API_KEYS_INLINE is a local-only affordance and is rejected outside APP_ENV=local.
# API_KEYS_SECRET_ID=workflow/api-keys
API_KEYS_INLINE={"tenants":[{"tenantId":"acme","status":"active","keys":[{"kid":"local-1","hash":"<sha256-of-key>"}]}]}
AUTH_CACHE_TTL_MS=60000
AUTH_NEGATIVE_CACHE_MS=5000

# ---- External provider (docs/adr/0008-external-provider-integration.md) -----
PROVIDER_BASE_URL=http://localhost:8090         # required (worker role)
PROVIDER_TIMEOUT_MS=5000
PROVIDER_CONNECT_TIMEOUT_MS=2000

# ---- Reconciler -------------------------------------------------------------
OUTBOX_STALE_AFTER_MS=60000
RECONCILE_PAGE_SIZE=50
# There is no variable for auto-failing stale workflows. The reconciler reports a passed
# deadline and never converts it into a business failure (INV-51, D-029).
